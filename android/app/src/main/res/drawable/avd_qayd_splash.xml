<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Subtle inner circle tint -->
            <path
                android:name="inner_fill"
                android:pathData="M 54,34 A 19,19 0 1,1 53.99,34 Z"
                android:fillColor="#162A4D82"
                android:fillAlpha="0" />

            <!-- Main Q / Qaf circle -->
            <path
                android:name="qaf_ring"
                android:pathData="M 54,34 A 19,19 0 1,1 53.99,34 Z"
                android:strokeColor="#2A4D82"
                android:strokeWidth="4.6"
                android:strokeLineCap="round"
                android:trimPathStart="0"
                android:trimPathEnd="0" />

            <!-- Q / Qaf tail -->
            <path
                android:name="qaf_tail"
                android:pathData="M 63.8,61.6 C 64.9,70.2 62.2,77.8 56.2,83.2"
                android:strokeColor="#2A4D82"
                android:strokeWidth="4.6"
                android:strokeLineCap="round"
                android:trimPathStart="0"
                android:trimPathEnd="0" />

            <!-- Left Teal Dot -->
            <group
                android:name="dot_left_group"
                android:pivotX="48"
                android:pivotY="25.5"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="dot_left"
                    android:pathData="M 48,22.4 A 3.1,3.1 0 1,1 47.99,22.4 Z"
                    android:fillColor="#0B8072" />
            </group>

            <!-- Right Teal Dot -->
            <group
                android:name="dot_right_group"
                android:pivotX="60"
                android:pivotY="25.5"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="dot_right"
                    android:pathData="M 60,22.4 A 3.1,3.1 0 1,1 59.99,22.4 Z"
                    android:fillColor="#0B8072" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 1. Draw the Q / Qaf circle -->
    <target android:name="qaf_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="520"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- Fade in subtle inner circle -->
    <target android:name="inner_fill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:startOffset="350"
                android:duration="400"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- 2. Draw the Q / Qaf tail -->
    <target android:name="qaf_tail">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:startOffset="380"
                android:duration="340"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>

    <!-- 3. Pop in Left Teal Dot -->
    <target android:name="dot_left_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:startOffset="560"
                    android:duration="280"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:startOffset="560"
                    android:duration="280"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- 4. Pop in Right Teal Dot -->
    <target android:name="dot_right_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:startOffset="660"
                    android:duration="280"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:startOffset="660"
                    android:duration="280"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
